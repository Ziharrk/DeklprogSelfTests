cabal-version:      3.0
name:               code
version:            0.1.0.0
build-type:         Simple

common warnings
    ghc-options: -Wall -Wno-name-shadowing -Wno-type-defaults

library
    import:           warnings
    exposed-modules:
      FFT
      Polynomial
    build-depends:    base ^>=4.20.2.0
    hs-source-dirs:   src
    default-language: GHC2024
    default-extensions:
      CPP
    cpp-options:
      -UTEMPLATE

